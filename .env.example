# Set these in your hosting provider or shell. This file is not loaded automatically.
HOST=127.0.0.1
PORT=3000
PROXY_PORT=3001

# Public hosting needs TWO different HTTPS origins, routed to the two ports.
# Prefer a separate site/domain for the proxy; keep app cookies off that origin.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://app.example.com
# PROXY_ORIGIN=https://browser.example.net

# Optional locally; required on public bind unless ALLOW_PUBLIC_PROXY=true.
# Use a random private token of at least 16 characters. Never commit the token.
# PROXY_AUTH_USER=monkeh
# PROXY_AUTH_TOKEN=
# ALLOW_PUBLIC_PROXY=false

# Primary is local /wisp/. Up to TEN additional authorized Wisp endpoints.
# No public service is assumed: verify the operator's terms and availability.
WISP_BACKUPS_JSON=[]
# Example shape only, not a working service:
# WISP_BACKUPS_JSON=[{"name":"Backup 1","url":"wss://your-wisp.example.net/wisp/"}]

WISP_ALLOWED_PORTS=80,443,8080,8443
WISP_MAX_CONNECTIONS=64
WISP_MAX_CONNECTIONS_PER_IP=16

# Optional existing authenticated remote Windows gateway, such as Guacamole.
# The built-in v86 Windows 2000/98 launchers need no account or gateway config.
# WINDOWS_VM_URL=https://your-desktop.example.net/guacamole/
# WINDOWS_VM_NAME=My Windows desktop
